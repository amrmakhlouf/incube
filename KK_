    CASE 
		WHEN SUM(CASE WHEN TD.Price = 0 THEN 0 ELSE 1 END) = 0 THEN 'ZZFC'
        ELSE 'YKKC' 
    END AS OrderType, 
    CASE 
        WHEN SUM(TD.Price) = 0 and (t.TransactionTypeID in (1, 3)  and  CreationReason<> 2 )THEN 'ZFFD' 
        ELSE 'YKEE'
    END AS MainItem, 
    O.OrganizationCode, 
    CASE 
        WHEN T.TransactionTypeID IN (2, 4) THEN PSL.Description
        WHEN UL.Description IS NULL THEN '' 
        ELSE LEFT(UL.Description, CHARINDEX('_', UL.Description) - 1) 
    END AS OrderReason,
    CASE T.TransactionTypeID 
        WHEN 2 THEN RSR.BillingRef 
        WHEN 4 THEN EXS.BillingRef 
        ELSE '' 
    END AS Reference,
	CASE 
        WHEN SUM(TD.Price) = 0 and (t.TransactionTypeID in (1, 3)  and  CreationReason<> 2 )THEN 1 
		WHEN SUM(CASE WHEN TD.Price = 0 THEN 1 ELSE 0 END) > 0 THEN 2
        ELSE 0 
    END AS isFOC,
	CASE WHEN T.TransactionTypeID IN (1,3) AND T.SalesMode = 3 THEN 'X' 
	WHEN T.TransactionTypeID IN (1,3) AND T.SalesMode = 2 AND EKH.TransactionID IS NOT NULL THEN 'X'
	ELSE '' END CreditExceed
FROM 
    [Transaction] T
    INNER JOIN CustomerOutlet CO ON CO.CustomerID = T.CustomerID AND CO.OutletID = T.OutletID
    INNER JOIN Employee E ON E.EmployeeID = T.EmployeeID
    INNER JOIN V_SAP_InvoiceCreation V ON V.CustomerTypeID = IIF(CO.CustomerTypeID=3 AND CO.BillsOpenNumber =1,1,T.SalesMode) AND V.TransactionTypeID = T.TransactionTypeID
    INNER JOIN Organization O ON O.OrganizationID = T.OrganizationID
    LEFT JOIN SAP_Reference SR ON SR.TransactionID = T.TransactionID
    INNER JOIN [TransactionDetail] TD ON TD.TransactionID = T.TransactionID
    LEFT JOIN UnlimitedFOCReasonsLanguage UL ON UL.UnlimitedFOCReasonID = T.UnlimitedFOCReasonID AND UL.LanguageID = 1
    OUTER APPLY (
        SELECT TOP 1 LEFT(Description, CHARINDEX('_', Description) - 1) AS Description FROM PackStatusLanguage PSL 
        WHERE PSL.StatusID = TD.PackStatusID AND PSL.LanguageID = 1
    ) PSL
    OUTER APPLY (
        SELECT TOP 1 RS.BillingRef FROM ReturnInvoicesHistory RIH 
        INNER JOIN SAP_Reference RS ON RS.TransactionID = RIH.SalesTransactionID AND RS.BillingRef IS NOT NULL 
		INNER JOIN Pack P ON P.PackID = TD.PackID AND P.ItemID = RIH.ItemID
        WHERE RIH.ReturnTransactionID = T.TransactionID AND RIH.BatchNo = TD.BatchNo AND RIH.ExpiryDate = TD.ExpiryDate
    ) RSR
    LEFT JOIN SAP_Reference EXS ON EXS.TransactionID = T.SourceTransactionID AND EXS.BillingRef IS NOT NULL
	LEFT JOIN V_SAP_FOCWithSales FOC ON FOC.CustomerTypeID = IIF(CO.CustomerTypeID=3 AND CO.BillsOpenNumber =1,1,T.SalesMode) AND FOC.TransactionTypeID = T.TransactionTypeID
	LEFT JOIN PostingTransaction PT ON PT.TransactionID = T.TransactionID
	LEFT JOIN EmployeeKeyHistory EKH ON EKH.TransactionID = T.TransactionID AND EKH.EmployeeID = T.EmployeeID AND EKH.RouteHistoryID = T.RouteHistoryID AND EKH.KeyTypeID in (2,3) AND EKH.Used = 1
WHERE T.Synchronized = 0 AND T.Voided <> 1 AND SR.TransactionID IS NULL AND T.TransactionTypeID IN (1, 2) AND PT.TransactionID IS NULL --AND T.transactionid = 'INV-87425-000006'
    AND (
        CASE T.TransactionTypeID 
            WHEN 2 THEN RSR.BillingRef 
            WHEN 4 THEN EXS.BillingRef 
            ELSE '' 
        END 
    ) IS NOT NULL
GROUP BY 
    CO.CustomerCode, 
    E.EmployeeCode, 
    T.Discount, 
    T.TransactionID, 
    V.OrderType, 
    V.MainItem, 
    O.OrganizationCode, 
    UL.Description,
    T.TransactionTypeID,
    PSL.Description,
    RSR.BillingRef,
    EXS.BillingRef,
	FOC.OrderType,
	FOC.MainItem,
	T.SalesMode,
	EKH.TransactionID,
	CreationReason
	,T.CustomerRefNo
	 ) tt inner join [Transaction] t on t.TransactionID= tt.TransactionID   inner join Division d on d.DivisionID = t.DivisionID
	inner join ConsignmentOrder co on co.OrderID = t.TransactionID and co.CustomerID = t.CustomerID and co.OutletID = t.OutletID
	where t.Synchronized = 0 and t.TransactionTypeID <> 17 AND t.TransactionDate >= '{0}' AND t.TransactionDate < '{1}' {2}", Filters.FromDate.ToString("yyyy-MM-dd"), Filters.ToDate.AddDays(1).ToString("yyyy-MM-dd"), salespersonFilter);
                incubeQuery = new InCubeQuery(db_vms, headerQuery);

                if (incubeQuery.Execute() != InCubeErrors.Success)
                {
                    res = Result.Failure;
                    throw (new Exception("Order header query failed !!"));
                }

                DataTable dtHeader = incubeQuery.GetDataTable();
                if (dtHeader.Rows.Count == 0)
